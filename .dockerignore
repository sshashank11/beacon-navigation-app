# Everything the image does not need. The OSM extract is deliberately not
# ignored, because the Dockerfile copies it in.
.git
.github
node_modules
web
pipeline
graph-cache
api/build
api/.gradle
data/*
!data/osm
data/osm/*
!data/osm/nyc.osm.pbf
# Keeps data/osm present in the context even without the extract, so the
# build reaches its own error message instead of failing on a missing path.
!data/osm/.gitkeep
scripts
*.md
*.dump
*.backup
*.sql.gz
.env
.env.example
