# Database
POSTGRES_DB=beacon
POSTGRES_USER=beacon
POSTGRES_PASSWORD=beacon
DATABASE_URL=jdbc:postgresql://localhost:5432/beacon
PIPELINE_DATABASE_URL=postgresql://beacon:beacon@localhost:5432/beacon

# Redis
REDIS_URL=redis://localhost:6379
POLLEN_DAILY_CALL_BUDGET=60

# Live environmental data
NYCCAS_RASTER_DIR=./data/nyccas
NYC_OPEN_DATA_APP_TOKEN=

# MinIO / S3-compatible storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=beacon
MINIO_SECRET_KEY=beacon-password
MINIO_BUCKET=beacon

# Data provider API keys
OPENAQ_API_KEY=
AIRNOW_API_KEY=
GOOGLE_MAPS_KEY=
MAPILLARY_TOKEN=
FISH_AUDIO_KEY=

# NWS requires a descriptive User-Agent with contact information.
NWS_USER_AGENT=BeaconNavigationApp/0.1 (contact@example.com)

# Routing data
BEACON_OSM_PATH=data/osm/nyc.osm.pbf
BEACON_GRAPH_PATH=graph-cache
